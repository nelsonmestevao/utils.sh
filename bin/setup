#!/usr/bin/env bash
#
# Install the tools to test, lint and format this project.

set -Eeuo pipefail

if [[ -f /etc/arch-release ]]; then
  yay -S --needed bash-bats kcov make shellcheck shfmt
elif [[ -f /etc/fedora-release ]]; then
  sudo dnf install -y bats kcov make ShellCheck shfmt
elif [[ -f /etc/debian_version ]]; then # Debian and Ubuntu
  sudo apt-get update
  sudo apt-get install -y --no-install-recommends bats kcov make shellcheck shfmt
elif grep -qs "NAME=NixOS" /etc/os-release; then
  nix develop --command "$SHELL"
else
  echo "Error: This script does not support your operating system." >&2
  exit 1
fi
